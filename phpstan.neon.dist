# Base configuration.
# Used as is by the extension verifier, which has no platform checkout.
# No %Shopware*% placeholders, no includes from the platform.
# Unmatched ignores are off, because the verifier runs fewer rules than phpstan.dev.neon.
# All ignoreErrors belong here, also for rules that only run in phpstan.dev.neon.
includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    tmpDir: var/cache/phpstan
    paths:
        - src
        - tests
    excludePaths:
        - src/Resources
        - tests/Jest (?)
        - tests/acceptance (?)
    symfony:
        constantHassers: false

    ignoreErrors:
        - message: '#Service ".*" is private#'
          paths:
              - tests/**/*Test.php

        - identifier: shopware.disallow.default.context.creation
          path: tests/*

        - identifier: shopware.unexpectedTestCovers
          paths:
              - tests/Core/Migration/*Test.php
              - tests/Migration/*Test.php
              - tests/Profile/*Test.php
              - tests/unit/*Test.php

        # TODO: to fix those issues, the AbstractProvider needs a generic type, which could then be used further down in the methods as typehints for other generic typed parameters
        - message: '#(readTotalFromRepo|readTableFromRepo|cleanupSearchResult)\(\) has parameter .* with generic class#'
          path: src/DataProvider/Provider/Data/AbstractProvider.php

        # TODO: remove this for 6.8 compatibility
        - message: '#Access to constant on deprecated class Shopware\\Core\\Checkout\\Payment\\Cart\\PaymentHandler\\DebitPayment#'
          paths:
              - src/Profile/Shopware/Premapping/PaymentMethodReader.php
              - tests/Profile/Shopware/Premapping/PaymentMethodReaderTest.php
        - message: '#Call to deprecated method __construct\(\) of class Shopware\\Core\\Framework\\DataAbstractionLayer\\EntityDefinition#'
        - message: '#Call to deprecated method listTableColumns\(\) of class Doctrine\\DBAL\\Schema\\AbstractSchemaManager#'
        - message: '#Call to deprecated method listTableIndexes\(\) of class Doctrine\\DBAL\\Schema\\AbstractSchemaManager#'
        - message: '#Call to deprecated method getName\(\) of class Doctrine\\DBAL\\Schema\\AbstractAsset#'
        - message: '#Call to deprecated method listTableForeignKeys\(\) of class Doctrine\\DBAL\\Schema\\AbstractSchemaManager#'
          paths:
              - src/Profile/Shopware/Gateway/Local/Reader/AttributeReader.php
        - message: '#Call to deprecated method getLocalColumns\(\) of class Doctrine\\DBAL\\Schema\\ForeignKeyConstraint#'
          paths:
              - src/Profile/Shopware/Gateway/Local/Reader/AttributeReader.php
        - identifier: shopware.stripTags
          paths:
              - src/Profile/Shopware/Converter/ShopwareConverter.php
              - src/Profile/Shopware/Converter/TranslationConverter.php

        # TODO: The MainOrContainer type cannot fully express its state after nested array mutations
        - identifier: parameterByRef.type
          path: src/Profile/Shopware/Converter/ShippingMethodConverter.php

        # This rule's exemption only accepts @see targets in the \Tests\Integration\ namespace,
        # which plugins (namespace SwagMigrationAssistant\Test\) cannot satisfy.
        - identifier: shopware.codeCoverageIgnoreOnLogic
          reportUnmatched: false

        # TODO: remove this for 6.9 compatibility
        - message: '#tag:v6.9.0#'
          identifiers:
            - parameter.deprecatedClass
            - property.deprecatedClass
            - instanceof.deprecatedClass
            - method.deprecatedClass
            - classConstant.deprecatedClass
            - method.deprecated
