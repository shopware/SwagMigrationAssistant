{
  "name": "swag-migration-assistant-tests",
  "author": "shopware AG",
  "version": "1.0.0",
  "scripts": {
    "unit": "npx jest --config jest.config.js --ci",
    "unit-watch": "npx jest --config jest.config.js --watch --coverage=false",
    "lint": "npx eslint ./",
    "lint:fix": "npx eslint --fix ./",
    "format": "npx prettier --check \"src/**/*.{js,ts}\" --config ../../.prettierrc.json --cache",
    "format:fix": "npx prettier --write \"src/**/*.{js,ts}\" --config ../../.prettierrc.json --cache"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@shopware-ag/jest-preset-sw6-admin": "6.0.4",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vue/test-utils": "2.4.6",
    "axios": "0.30.3",
    "axios-mock-adapter": "2.1.0",
    "babel-jest": "30.2.0",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-typescript": "7.28.5",
    "eslint": "9.39.3",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-file-progress": "1.5.0",
    "eslint-plugin-jest": "28.14.0",
    "globals": "15.15.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-junit": "15.0.0",
    "picomatch": "4.0.4",
    "prettier": "3.6.2",
    "prettier-plugin-multiline-arrays": "3.0.6",
    "typescript": "5.7.3",
    "entities": "4.5.0"
  }
}
