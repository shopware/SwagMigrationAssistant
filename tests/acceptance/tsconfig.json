{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": ".",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@fixtures/*": ["fixtures/*"],
    }
  },
  "include": [
    "./**/*.js",
    "./**/*.ts",
    ".eslintrc.cjs"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
