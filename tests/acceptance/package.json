{
    "name": "swag-migration-assistant-acceptance",
    "author": "shopware AG",
    "version": "1.0.0",
    "scripts": {
        "lint:types": "tsc",
        "test": "npx playwright test",
        "test:ui": "npx playwright test --headed",
        "test:update": "UPDATE_SNAPSHOTS=1 npx playwright test",
        "lint": "npx eslint \"playwright.config.ts\" \"fixtures/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "npx eslint --fix \"playwright.config.ts\" \"fixtures/**/*.ts\" \"tests/**/*.ts\"",
        "format": "npx prettier --check \"./**/*.{spec.ts,ts}\" \"../../.github/bin/**/*.ts\" --config ../../.prettierrc.json --cache",
        "format:fix": "npx prettier --write \"./**/*.{spec.ts,ts}\" \"../../.github/bin/**/*.ts\" --config ../../.prettierrc.json --cache"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.5",
        "globals": "17.13.0",
        "@typescript-eslint/eslint-plugin": "8.71.2",
        "@typescript-eslint/parser": "8.71.2",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-playwright": "2.12.1",
        "prettier": "3.9.10",
        "prettier-plugin-multiline-arrays": "4.1.11",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@playwright/test": "1.64.1",
        "@shopware-ag/acceptance-test-suite": "12.24.1",
        "dotenv": "18.0.7"
    }
}
