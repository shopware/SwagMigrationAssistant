{
  "name": "swagmigrationassistant",
  "version": "1.0.0",
  "description": "Migrate shop data to Shopware 6",
  "author": "shopware AG",
  "license": "MIT",
  "scripts": {
    "lint": "eslint --ext .js,.ts,.vue,.html,.html.twig .",
    "lint:fix": "npm run lint -- --fix",
    "lint:scss": "stylelint ./**/*.scss",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "format": "prettier --check \"src/**/*.{js,ts}\" --config ../../../../.prettierrc.json --cache",
    "format:fix": "prettier --write \"src/**/*.{js,ts}\" --config ../../../../.prettierrc.json --cache"
  },
  "devDependencies": {
    "@shopware-ag/eslint-config-base": "^2.0.0",
    "@shopware-ag/meteor-tokens": "1.0.0",
    "@shopware-ag/stylelint-plugin-meteor": "^1.1.0",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "axios": "^1.11.0",
    "core-js": "^2.6.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-file-progress": "^1.4.0",
    "eslint-plugin-filename-rules": "^1.3.1",
    "eslint-plugin-html": "^8.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-inclusive-language": "^2.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "prettier": "^3.4.2",
    "prettier-plugin-multiline-arrays": "^3.0.6",
    "stylelint": "^16.16.0",
    "stylelint-define-config": "^16.22.0",
    "typescript": "^5.7.3",
    "vue": "^3.5.18",
    "vue-eslint-parser": "^9.4.3"
  }
}
