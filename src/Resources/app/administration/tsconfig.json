{
  "include": [
    "./src/**/*",
    "./scripts/**/*"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "commonjs",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "src": ["src"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noErrorTruncation": false
  }
}
